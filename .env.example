VITE_API_URL=http://localhost:3000
VITE_ENV=development

# Sentry — paste the DSN from your Sentry project (Settings > Client Keys).
# Baked into the renderer bundle by Vite; only active when import.meta.env.PROD.
VITE_SENTRY_DSN=

# Sentry source-map upload (build-time only, never shipped to users).
# Auth token: sentry.io/settings/account/api/auth-tokens/ (needs project:releases scope)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


